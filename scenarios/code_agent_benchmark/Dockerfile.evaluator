FROM python:3.11-slim

WORKDIR /app

# Copy evaluator source
COPY scenarios/code_agent_benchmark/evaluator/src /app/src
COPY scenarios/code_agent_benchmark/tasks /app/tasks

# Install dependencies
RUN pip install --no-cache-dir \
    a2a-sdk[http-server]>=0.3.20 \
    httpx>=0.28.1 \
    pydantic>=2.11.9 \
    pytest>=8.0.0

WORKDIR /app/src

ENTRYPOINT ["python", "server.py"]
